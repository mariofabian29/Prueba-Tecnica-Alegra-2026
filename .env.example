# ---------------------------------------------------------------------------
# Base de datos
#
# En local se usa SQLite en un archivo: no hay que instalar nada.
# Al desplegar (ver DEPLOY.md) esta misma variable apunta a Postgres y el
# esquema se genera automaticamente para ese motor.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Secreto para firmar los JWT de sesion. Cambialo en produccion.
# ---------------------------------------------------------------------------
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-min-32-chars"

# ---------------------------------------------------------------------------
# IA (OPCIONAL). Si defines una API key de Anthropic, el panel de insights y el
# chatbot de gastos usan Claude de verdad. Si la dejas vacia, la app cae
# automaticamente a un motor heuristico local y sigue funcionando al 100%.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
