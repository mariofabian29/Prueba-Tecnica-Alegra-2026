// Plataforma de control de gastos de viaje
// Motor: SQLite (cero infraestructura, listo para ejecutar en local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  trips Trip[]
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  destination String
  country     String?
  budget      Float
  currency    String   @default("USD")
  startDate   DateTime
  endDate     DateTime
  notes       String?
  coverEmoji  String   @default("🌍")
  // Foto real del destino resuelta desde Wikimedia. Se guarda una vez y se
  // reutiliza; si no se consigue, la interfaz usa su ilustración generada.
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companions Companion[]
  expenses   Expense[]
  messages   ChatMessage[]

  @@index([userId, endDate])
}

model Companion {
  id     String  @id @default(cuid())
  tripId String
  name   String
  email  String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Expense {
  id          String   @id @default(cuid())
  tripId      String
  amount      Float
  currency    String   @default("USD")
  // Ver CATEGORIES en src/lib/categories.ts
  category    String   @default("OTHER")
  description String
  // Lugar del plan de viaje asociado al gasto (opcional)
  place       String?
  date        DateTime @default(now())
  paidBy      String   @default("Yo")
  // NONE | EQUAL (reparto entre los acompanantes del viaje)
  splitMode   String   @default("NONE")
  // Ruta publica de la foto del recibo, si se adjunto
  receiptUrl  String?
  // MANUAL | CHATBOT
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  tripId    String
  // user | assistant
  role      String
  content   String
  // text | receipt | draft  -> define como se pinta la burbuja en el chat
  kind      String   @default("text")
  // JSON serializado con los datos extra del mensaje (recibo o borrador de gasto)
  payload   String?
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}
